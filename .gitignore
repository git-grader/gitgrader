# Operating systems
.DS_Store
Thumbs.db
Desktop.ini

# Test and analysis output. These are anchored, because an unanchored directory name
# matches at every level: a bare "reports/" silently excluded the reports module and its
# tests from the repository while the build kept passing locally.
/coverage/
frontend/coverage/
/reports/
frontend/playwright-report/
frontend/test-results/
.scannerwork/

# Downloaded installers
*.deb
