root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = tab
indent_size = tab
tab_width = 4

[*.{yml,yaml,json,jsonc,ts,tsx,css,scss,md}]
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_style = space
indent_size = 2

[LICENSE]
trim_trailing_whitespace = false
