# Image and published ports. scripts/install.sh overwrites GITGRADER_VERSION with the
# version the checkout actually builds, so that compose starts what was just produced.
# Set it by hand only to run a published release image, and then do not run install.sh
# afterwards: it builds from source and would point this back at the source version.
GITGRADER_VERSION=0.1.0-SNAPSHOT
HTTP_PORT=8080
SSH_PORT=2222

# Owner applied to the data volumes before startup: the uid/gid the image runs as.
# scripts/install.sh reads these back from the image it is about to start, because a
# rebuild on a different base moves them and the application then cannot write to its
# own volumes. Read them yourself with:
#   docker inspect --format '{{.Config.User}}' ghcr.io/git-grader/gitgrader:<tag>
APP_UID=1002
APP_GID=1001

# Change this before any shared or production deployment. Generate with:
# openssl rand -base64 32
POSTGRES_PASSWORD=change-me-before-production
SPRING_DATASOURCE_URL=jdbc:postgresql://database:5432/gitgrader
SPRING_DATASOURCE_USERNAME=gitgrader
SPRING_DATASOURCE_PASSWORD=change-me-before-production

# Group that owns the host Docker socket. The grading runner talks to that socket, and
# the application runs unprivileged, so it must join this group or every grading run
# fails with a permission error. There is no portable default - read yours with:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Public endpoints advertised to people using the service
APP_PUBLIC_URL=http://localhost:8080
APP_SUPPORT_EMAIL=support@example.org
APP_ORGANIZATION_NAME=Example Organization
GIT_SSH_HOST=localhost
GIT_SSH_PORT=2222
GIT_LISTEN_ADDRESS=0.0.0.0
GIT_LISTEN_PORT=2222

# Docker runner: when app is containerized, Docker resolves mounts on the host.
GRADING_DOCKER_WORKSPACE_MOUNT_ROOT=/var/lib/docker/volumes/gitgrader_grading-data/_data
# The hidden tests are bound into the grading sandbox by the Docker daemon, which
# resolves paths on the host. Without this the application's own path is passed
# through, Docker creates it empty rather than failing, and every submission is
# graded against no tests at all and scored zero.
GRADING_DOCKER_TESTS_MOUNT_ROOT=/var/lib/docker/volumes/gitgrader_tests/_data
GRADING_MAX_PARALLEL_JOBS=2
GRADING_DEFAULT_TIMEOUT=120s
GRADING_DEFAULT_MEMORY_LIMIT=512MB
GRADING_DEFAULT_CPU_LIMIT=1.0
GRADING_DEFAULT_PID_LIMIT=256
GRADING_NETWORK_ENABLED=false

# Keep false until LDAP is configured. Local accounts must remain disabled in production.
SECURITY_LDAP_ENABLED=false
SECURITY_LOCAL_ACCOUNTS_ENABLED=false
SECURITY_SESSION_SECURE_COOKIE=false
SERVER_FORWARD_HEADERS_STRATEGY=none

# Keys the HMAC that turns a client address into the hash stored on an audit record.
# Left empty a fresh key is drawn at every startup, which is safe but means an address
# cannot be followed across a restart. Set a long random value here and treat it as a
# secret; changing it later invalidates correlation with the records already written.
AUDIT_IP_HASH_KEY=
AUDIT_RETENTION=P365D

# Development overlay only. These are read by compose.dev.yaml, which starts a throwaway
# LDAP directory alongside the application; compose.yaml on its own ignores them.
LDAP_ADMIN_PASSWORD=adminpassword
LDAP_PORT=1389
SECURITY_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
