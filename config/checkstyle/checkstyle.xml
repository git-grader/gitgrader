<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
		"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
		"https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Copyright the GitGrader contributors.
  SPDX-License-Identifier: Apache-2.0

  GitGrader Checkstyle rules.

  DESIGN NOTE: code formatting (indentation, whitespace, wrapping, import
  order) is owned exclusively by spring-javaformat-maven-plugin, which uses
  tab indentation. This ruleset therefore deliberately contains NO whitespace,
  indentation or line-wrapping rules - they would fight the formatter.

  What is enforced here is semantics: naming, API hygiene, error handling,
  complexity ceilings and a small set of project-specific security rules.
-->
<module name="Checker">
	<property name="severity" value="error" />
	<property name="charset" value="UTF-8" />
	<property name="fileExtensions" value="java" />

	<!-- ==================== File level ==================== -->
	<module name="FileLength">
		<property name="max" value="600" />
	</module>
	<module name="NewlineAtEndOfFile" />
	<module name="UniqueProperties" />

	<module name="RegexpSingleline">
		<property name="format" value="\s+$" />
		<property name="message" value="Line has trailing whitespace." />
	</module>
	<module name="RegexpSingleline">
		<property name="format" value="^\s*(System\.out|System\.err)\.print" />
		<property name="message"
				  value="Use a Logger (org.slf4j) instead of System.out/System.err. Grading output is written through the dedicated push-feedback writer." />
	</module>
	<module name="RegexpSingleline">
		<property name="format" value="printStackTrace\(\)" />
		<property name="message" value="Do not call printStackTrace(); log the exception with a Logger instead." />
	</module>
	<module name="RegexpSingleline">
		<property name="format" value="(?i)\b(zhaw|zurich university of applied sciences)\b" />
		<property name="message"
				  value="GitGrader must stay organization neutral. Move organization specific values into configuration." />
	</module>
	<module name="RegexpSingleline">
		<property name="format" value="TODO(?!:)" />
		<property name="message" value="Write TODO: with a colon and an explanation, or open an issue instead." />
		<property name="severity" value="warning" />
	</module>

	<!-- Suppressions are supplied by maven-checkstyle-plugin's suppressionsLocation. -->
	<module name="SuppressWarningsFilter" />

	<module name="TreeWalker">
		<module name="SuppressWarningsHolder" />

		<!-- ==================== Naming ==================== -->
		<module name="PackageName">
			<property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$" />
		</module>
		<module name="TypeName" />
		<module name="MethodName">
			<property name="format" value="^[a-z][a-zA-Z0-9]*$" />
		</module>
		<module name="LocalVariableName">
			<property name="format" value="^[a-z][a-zA-Z0-9]*$" />
		</module>
		<module name="LocalFinalVariableName" />
		<module name="MemberName" />
		<module name="ParameterName">
			<property name="format" value="^[a-z][a-zA-Z0-9]*$" />
		</module>
		<module name="StaticVariableName" />
		<module name="ConstantName">
			<!--
			  Allows the Spring convention `private static final Logger logger`, which is
			  what spring-javaformat's own codebase uses. Everything else still has to be
			  SHOUT_CASE.
			-->
			<property name="format" value="^(logger|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$" />
		</module>
		<module name="ClassTypeParameterName" />
		<module name="MethodTypeParameterName" />
		<module name="RecordComponentName" />
		<module name="PatternVariableName" />
		<module name="LambdaParameterName">
			<property name="format" value="^[a-z][a-zA-Z0-9]*$" />
		</module>
		<module name="CatchParameterName">
			<property name="format" value="^(ex|[a-z][a-zA-Z0-9]*)$" />
		</module>
		<module name="AbbreviationAsWordInName">
			<property name="allowedAbbreviationLength" value="3" />
			<property name="ignoreStatic" value="true" />
			<property name="ignoreFinal" value="true" />
			<property name="ignoreStaticFinal" value="true" />
			<property name="tokens"
					  value="CLASS_DEF,INTERFACE_DEF,ENUM_DEF,ANNOTATION_DEF,METHOD_DEF,RECORD_DEF" />
		</module>

		<!-- ==================== Imports ==================== -->
		<module name="AvoidStarImport">
			<property name="allowStaticMemberImports" value="true" />
		</module>
		<module name="RedundantImport" />
		<module name="UnusedImports">
			<property name="processJavadoc" value="true" />
		</module>
		<module name="IllegalImport">
			<property name="illegalPkgs"
					  value="sun,com.sun,jdk.internal,org.apache.commons.logging,java.util.logging,junit.framework" />
			<property name="illegalClasses"
					  value="org.springframework.lang.Nullable,org.springframework.lang.NonNull,javax.annotation.Nullable,org.jetbrains.annotations.Nullable" />
		</module>

		<!-- ==================== Structure and size ==================== -->
		<module name="MethodLength">
			<property name="max" value="80" />
			<property name="countEmpty" value="false" />
		</module>
		<module name="ParameterNumber">
			<property name="max" value="8" />
			<property name="ignoreOverriddenMethods" value="true" />
			<property name="tokens" value="METHOD_DEF" />
		</module>
		<module name="OuterTypeNumber" />
		<module name="OneTopLevelClass" />
		<module name="AnonInnerLength">
			<property name="max" value="30" />
		</module>

		<!-- ==================== Complexity ceilings ==================== -->
		<module name="CyclomaticComplexity">
			<property name="max" value="12" />
		</module>
		<module name="NPathComplexity">
			<property name="max" value="200" />
		</module>
		<module name="BooleanExpressionComplexity">
			<property name="max" value="5" />
		</module>
		<module name="NestedIfDepth">
			<property name="max" value="3" />
		</module>
		<module name="NestedTryDepth">
			<property name="max" value="2" />
		</module>
		<module name="ClassFanOutComplexity">
			<property name="max" value="30" />
		</module>

		<!-- ==================== Coding correctness ==================== -->
		<module name="EmptyCatchBlock">
			<property name="exceptionVariableName" value="expected|ignored" />
		</module>
		<module name="EqualsHashCode" />
		<module name="CovariantEquals" />
		<module name="EqualsAvoidNull" />
		<module name="StringLiteralEquality" />
		<module name="SimplifyBooleanExpression" />
		<module name="SimplifyBooleanReturn" />
		<module name="MissingSwitchDefault" />
		<module name="FallThrough" />
		<module name="DefaultComesLast" />
		<module name="IllegalCatch">
			<property name="illegalClassNames" value="java.lang.Error,java.lang.Throwable" />
		</module>
		<module name="IllegalThrows" />
		<module name="ModifiedControlVariable" />
		<module name="MultipleVariableDeclarations" />
		<module name="NoFinalizer" />
		<module name="NoClone" />
		<module name="SuperClone" />
		<module name="SuperFinalize" />
		<module name="PackageDeclaration" />
		<module name="ExplicitInitialization" />
		<module name="UnnecessarySemicolonInEnumeration" />
		<module name="UnnecessarySemicolonInTryWithResources" />
		<module name="UnnecessarySemicolonAfterTypeMemberDeclaration" />
		<module name="UnnecessarySemicolonAfterOuterTypeDeclaration" />
		<module name="OneStatementPerLine" />
		<module name="DeclarationOrder" />
		<module name="UnusedLocalVariable" />
		<module name="IllegalInstantiation">
			<property name="classes" value="java.lang.Boolean,java.util.Timer" />
		</module>
		<module name="IllegalTokenText">
			<property name="tokens" value="STRING_LITERAL,CHAR_LITERAL" />
			<property name="format" value="\\u00(09|0(a|A)|0(c|C)|0(d|D)|22|27|5(C|c))|\\(0(10|11|12|14|15|42|47)|134)" />
			<property name="message" value="Consider using special escape sequence instead of octal value or Unicode escaped value." />
		</module>
		<module name="ArrayTypeStyle" />
		<module name="UpperEll" />
		<module name="FinalClass" />
		<module name="HideUtilityClassConstructor" />
		<module name="InterfaceIsType" />
		<module name="MutableException" />
		<module name="VisibilityModifier">
			<property name="protectedAllowed" value="true" />
			<property name="allowPublicImmutableFields" value="true" />
			<property name="allowPublicFinalFields" value="true" />
		</module>
		<module name="InnerTypeLast" />
		<module name="ReturnCount">
			<property name="max" value="6" />
			<property name="maxForVoid" value="6" />
		</module>

		<!-- ==================== Modifiers ==================== -->
		<module name="ModifierOrder" />
		<module name="RedundantModifier" />

		<!-- ==================== Blocks ==================== -->
		<module name="NeedBraces" />
		<module name="EmptyBlock">
			<property name="option" value="text" />
			<property name="tokens" value="LITERAL_TRY,LITERAL_FINALLY,LITERAL_IF,LITERAL_ELSE,LITERAL_SWITCH,LITERAL_WHILE,LITERAL_DO,LITERAL_FOR,INSTANCE_INIT,STATIC_INIT" />
		</module>
		<module name="AvoidNestedBlocks">
			<property name="allowInSwitchCase" value="true" />
		</module>

		<!-- ==================== Javadoc on public API ==================== -->
		<module name="MissingJavadocType">
			<property name="scope" value="public" />
			<property name="excludeScope" value="nothing" />
			<property name="skipAnnotations" value="Configuration,ConfigurationProperties,Entity,Embeddable,Generated" />
		</module>
		<module name="JavadocType">
			<property name="scope" value="public" />
			<property name="allowMissingParamTags" value="true" />
		</module>
		<module name="SummaryJavadoc">
			<property name="forbiddenSummaryFragments" value="^@return the *|^This method returns |^A [{]@code [a-zA-Z0-9]+[}]( is a )" />
			<property name="period" value="." />
		</module>
		<module name="NonEmptyAtclauseDescription" />
		<module name="InvalidJavadocPosition" />
		<module name="JavadocContentLocation" />
		<module name="JavadocBlockTagLocation" />
		<module name="JavadocMissingLeadingAsterisk" />
		<module name="SingleLineJavadoc" />

		<!-- ==================== Annotations ==================== -->
		<module name="AnnotationLocation">
			<property name="allowSamelineMultipleAnnotations" value="false" />
			<property name="allowSamelineSingleParameterlessAnnotation" value="false" />
		</module>
		<module name="MissingOverride" />
		<module name="PackageAnnotation" />

		<!-- ==================== Magic numbers ==================== -->
		<module name="MagicNumber">
			<property name="ignoreNumbers" value="-1, 0, 1, 2, 3, 100" />
			<property name="ignoreAnnotation" value="true" />
			<property name="ignoreFieldDeclaration" value="true" />
			<property name="ignoreHashCodeMethod" value="true" />
		</module>
	</module>
</module>
