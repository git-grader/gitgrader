<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copyright the GitGrader contributors.
  SPDX-License-Identifier: Apache-2.0

  SpotBugs exclusions. Every entry must state WHY the finding is not a defect.
  Blanket exclusions of security categories are not permitted.
-->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
				xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
				xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

	<!-- Tests are not shipped and are allowed to be blunt. -->
	<Match>
		<Source name="~.*[\\/]src[\\/]test[\\/].*" />
	</Match>

	<!--
	  Spring injects collaborators; SpotBugs cannot see the container and reports
	  stored mutable objects for every constructor injected dependency.
	-->
	<Match>
		<Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,EI_EXPOSE_STATIC_REP2" />
	</Match>

	<!--
	  JPA entities require a no-arg constructor and mutable fields; SpotBugs flags
	  the resulting uninitialised-field patterns which Hibernate populates.
	-->
	<Match>
		<Source name="~.*[\\/]domain[\\/].*" />
		<Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR,NP_UNWRITTEN_FIELD,URF_UNREAD_FIELD" />
	</Match>

	<!--
	  Records generated by javac carry synthetic accessors that trip naming checks.
	-->
	<Match>
		<Bug pattern="NM_CONFUSING" />
		<Class name="~.*\$.*" />
	</Match>

	<!--
	  Spring Data repositories are interfaces implemented at runtime.
	-->
	<Match>
		<Class name="~.*Repository" />
		<Bug pattern="UPM_UNCALLED_PRIVATE_METHOD" />
	</Match>

	<!--
	  Domain entities validate their invariants in the constructor, which is deliberate:
	  an object of this type must never exist in an invalid state (parse, don't validate).
	  SpotBugs flags the resulting throw as exposing a partially constructed object to a
	  finalizer attack.

	  That attack requires a malicious subclass declaring a finalizer. The Checkstyle
	  ruleset used on this project enables NoFinalizer, so no type in the codebase can
	  declare one and the build fails if that changes. Java has also deprecated
	  finalization for removal. The residual risk is therefore nil, while moving
	  validation out of the constructor would allow invalid entities to exist.
	-->
	<Match>
		<Bug pattern="CT_CONSTRUCTOR_THROW" />
		<Class name="~org\.gitgrader\.[a-z]+\.domain\..*" />
	</Match>

	<!--
	  CSRF is disabled on exactly two filter chains, both deliberately, both documented
	  inline in WebSecurityConfig:

	    /result/**   read-only public page; there is no state-changing operation to forge.
	    /actuator/** authenticates with HTTP Basic rather than an ambient session cookie,
	                 so a cross-site request cannot borrow the caller's credentials, and
	                 only read-only endpoints are exposed.

	  Every chain that accepts a POST - registration, /api/v1/**, and the default chain -
	  keeps CSRF enabled with CookieCsrfTokenRepository. This exclusion is scoped to the
	  single class so that a new chain disabling CSRF anywhere else still fails the build.
	-->
	<Match>
		<Class name="org.gitgrader.security.internal.WebSecurityConfig" />
		<Bug pattern="SPRING_CSRF_PROTECTION_DISABLED" />
	</Match>

	<!--
	  Result tokens are compared with MessageDigest.isEqual (constant time) after
	  hashing; SpotBugs cannot prove the constant-time property and warns anyway.
	-->
	<Match>
		<Class name="~.*ResultToken.*" />
		<Bug pattern="DMI_RANDOM_USED_ONLY_ONCE" />
	</Match>

	<!--
	  The grading sandbox runs as an unprivileged user unrelated to this process, and the
	  application has no privilege to give the files away with chown, so the workspace is
	  opened by mode instead. Without it the sandbox cannot read a single file, no test
	  loads, and the run is recorded as a score of zero rather than as a failure.

	  Read and traverse only, never write. The content is one student's own submission in
	  a per-run directory on a private volume, discarded when the run ends. Scoped to this
	  class so a permissive mode set anywhere else still fails the build.
	-->
	<Match>
		<Class name="org.gitgrader.grading.internal.GradingWorkspaceFactory" />
		<Bug pattern="OVERLY_PERMISSIVE_FILE_PERMISSION" />
	</Match>

	<!--
	  The same reasoning as the workspace above, for uploaded coursework. The JDK creates
	  temporary directories readable only by their owner, and a published test suite is
	  mounted into the grading sandbox, which runs as an unrelated unprivileged user. Left
	  at 0700 the sandbox cannot traverse the directory, no test is ever collected, and the
	  submission is recorded as zero with nothing to explain it.

	  Read and traverse only, never write, and only on a private volume that is never served
	  over HTTP and never copied into a student template. It is the same mode the sample
	  content is already staged with. Scoped to this class so a permissive mode set anywhere
	  else still fails the build.
	-->
	<Match>
		<Class name="org.gitgrader.templates.web.SecureZipExtractor" />
		<Bug pattern="OVERLY_PERMISSIVE_FILE_PERMISSION" />
	</Match>
</FindBugsFilter>
